<?xml version="1.0" encoding="utf-8"?>
<!-- OrchestraApp: a single APK that is BOTH a normal launchable app (Compose UI) AND an
     LSPosed module (xposed meta-data + assets/xposed_init). It hosts the device-settings
     provider services + RFCOMM, and its hooks (loaded by LSPosed into SystemUI/Settings)
     render the volume-panel ANC tile and write metadata key 25 from a privileged process —
     replacing the KSU priv-app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Signature permission guarding the battery-change broadcast receiver registered in the
         Settings process. Only the Orchestra app (same signer) can deliver to that receiver;
         com.android.settings (platform-signed) is a different signer and cannot hold this. -->
    <permission android:name="io.github.thelok1s.orchestra.permission.BATTERY_BROADCAST"
                android:protectionLevel="signature" />
    <!-- The app must REQUEST its own signature permission to actually HOLD it (declaring a
         <permission> does not self-grant). Without this the app's sendBroadcast does not satisfy
         the receiver's broadcastPermission gate, so the live-battery broadcast never arrives. -->
    <uses-permission android:name="io.github.thelok1s.orchestra.permission.BATTERY_BROADCAST" />

    <!-- Signature permission for the AAP state broadcast (SystemUI broker -> app). DECLARED +
         requested so the guarded-receiver option is available, but the app's AAP_STATE receiver is
         currently registered with NO permission: SystemUI is a different signer and cannot hold
         this, so a guarded receiver would reject its broadcast (Plan 5 T3 asymmetry). The payload
         is non-sensitive device state. Final guard choice pending hardware confirmation. -->
    <permission android:name="io.github.thelok1s.orchestra.permission.AAP_STATE"
                android:protectionLevel="signature" />
    <uses-permission android:name="io.github.thelok1s.orchestra.permission.AAP_STATE" />

    <!-- Signature permission guarding the VolumeApplyReceiver. Only the Orchestra app (same signer)
         can invoke it to prevent third-party applications from triggering volume changes. -->
    <permission android:name="io.github.thelok1s.orchestra.permission.VOLUME_APPLY"
                android:protectionLevel="signature" />
    <uses-permission android:name="io.github.thelok1s.orchestra.permission.VOLUME_APPLY" />

    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Held only while a KSU priv-app backing still exists; once KSU is dropped the metadata
         write happens from the Settings-process hook instead. -->
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".App"
        android:label="Orchestra"
        android:icon="@mipmap/orchestra"
        android:roundIcon="@mipmap/orchestra"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Orchestra">

        <!-- LSPosed / Xposed module markers -->
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription"
            android:value="Native Soundcore controls on Pixel: volume-panel ANC tile + device-settings page, via the device-settings framework." />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="Orchestra"
            android:theme="@style/Theme.Orchestra">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Config provider: SettingsLib binds this (package/class/action from metadata key 25). -->
        <service
            android:name=".ConfigProviderService"
            android:exported="true"
            android:permission="android.permission.BLUETOOTH_PRIVILEGED">
            <intent-filter>
                <action android:name="io.github.thelok1s.orchestra.BIND_DEVICE_SETTINGS_CONFIG_PROVIDER" />
            </intent-filter>
        </service>

        <!-- Setting provider: serves/handles the ANC control, backed by the RFCOMM engine. -->
        <service
            android:name=".SettingProviderService"
            android:exported="true"
            android:permission="android.permission.BLUETOOTH_PRIVILEGED">
            <intent-filter>
                <action android:name="io.github.thelok1s.orchestra.BIND_DEVICE_SETTINGS_PROVIDER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <receiver android:name=".ConnectReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="io.github.thelok1s.orchestra.APPLY" />
            </intent-filter>
        </receiver>

        <!-- Applies an ANC mode by toggle index (fired by the volume-panel hook). -->
        <receiver android:name=".VolumeApplyReceiver"
                  android:exported="true"
                  android:permission="io.github.thelok1s.orchestra.permission.VOLUME_APPLY">
            <intent-filter>
                <action android:name="io.github.thelok1s.orchestra.APPLY_INDEX" />
            </intent-filter>
        </receiver>

        <!-- Debug: send an arbitrary RFCOMM cmd+payload to probe control sequences. Not exported —
             root/adb shell can still reach it via `am broadcast -n` with the component named, so
             the debug workflow is unaffected. -->
        <receiver android:name=".DebugSendReceiver" android:exported="false">
            <intent-filter>
                <action android:name="io.github.thelok1s.orchestra.DEBUG_SEND" />
                <action android:name="io.github.thelok1s.orchestra.AACP_TEST" />
                <action android:name="io.github.thelok1s.orchestra.AACP_MF" />
            </intent-filter>
        </receiver>

        <!-- Battery state bridge: the privileged Settings-process hook queries this to read
             per-bud battery from the app process and write untethered-battery metadata keys. -->
        <provider
            android:name=".StateProvider"
            android:authorities="io.github.thelok1s.orchestra.state"
            android:exported="true"
            android:readPermission="android.permission.BLUETOOTH_PRIVILEGED"
            android:writePermission="android.permission.BLUETOOTH_PRIVILEGED" />
    </application>
</manifest>
